{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.altfndata/altfinance-mcp",
  "title": "ALT/FNDATA",
  "description": "Auction comparables for luxury & collectibles appraisal: search, stats, price trends, valuations.",
  "websiteUrl": "https://altfndata.com",
  "repository": {
    "url": "https://github.com/altfndata/altfndata-mcp",
    "source": "github"
  },
  "version": "0.4.7",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "altfinance-mcp",
      "version": "0.4.7",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ALTFINANCE_API_KEY",
          "description": "Your ALT/FNDATA API key (get one at https://app.altfndata.com/#/mcp).",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "ALTFINANCE_API_URL",
          "description": "ALT/FNDATA API base URL.",
          "default": "https://api.altfndata.com"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.altfndata.com/mcp"
    }
  ]
}
